# Vorlage für die Umgebungsdatei der Testumgebung (#58). Kopieren nach testumgebung/.env
# (README.md, „Testumgebung im Container“); die Datei .env kommt nie ins Repo (.gitignore).
# Alle Werte hier sind erfunden und nur für den eigenen Rechner. Auf dem Server stehen
# eigene, geheime Werte (#59).
#
# Hier ist jede Einstellung des Tools beschrieben, genau einmal (#324); .env.example für den
# eigenen Rechner verweist hierher. Die Absicherungen für den Betrieb auf einem Server
# listet docs/betrieb.md.

# Schlüssel, mit dem Django Sitzungen und Formulare absichert. Pflicht; auf jedem Server ein
# eigener, langer Zufallswert.
DJANGO_SECRET_KEY=testumgebung-lokal-nicht-geheim-auf-dem-server-ersetzen

# Namen, unter denen das Tool erreichbar ist, durch Kommas getrennt. Auf dem Server die Testdomain.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Datenbank: Name, Benutzer und Passwort, alle drei Pflicht. In der Testumgebung die eigene
# Datenbank (Container „datenbank“); Rechner und Port trägt dort die Compose-Datei ein.
POSTGRES_DB=dpv
POSTGRES_USER=dpv
POSTGRES_PASSWORD=testumgebung-lokal-nicht-geheim

# Keycloak: Adresse des Realms, wie der Browser sie erreicht, und Zugang des Login-Clients.
# Auf dem Server der Test-Realm im Keycloak des DPV (README.md, „Test-Realm im Keycloak des DPV“).
KEYCLOAK_REALM_URL=http://localhost:8081/realms/dpv
KEYCLOAK_CLIENT_ID=dpv-anmeldetool
KEYCLOAK_CLIENT_SECRET=nur-lokal-nicht-geheim

# Nur für die Keycloak-Testumgebung auf dem eigenen Rechner (Profil „lokal“): Das Tool im
# Container erreicht sie unter keycloak:8080, der Browser unter localhost:8081. Auf dem Server
# diese Zeile löschen; mit ihr startet das Tool dort nicht (Startprüfung, docs/betrieb.md).
KEYCLOAK_REALM_URL_INTERN=http://keycloak:8080/realms/dpv

# Nur auf dem Server, wenn dort ein Programm davor HTTPS annimmt (#59): 1 = Cookies nur über
# HTTPS, Weiterleitung von http auf https und die Bitte an den Browser, ein Jahr lang nur HTTPS
# zu nutzen (HSTS). Voraussetzung am Programm davor: docs/betrieb.md, „Hinweis auf HTTPS“.
# DJANGO_BEHIND_HTTPS_PROXY=1

# 0 = Link „Noch kein Konto? Registrieren“ auf der Login-Seite ausblenden; dann nennt die
# Login-Seite diese Adresse für Fragen zum Konto. Ohne Angabe: Link sichtbar, Adresse wie hier.
# REGISTRATION_LINK_ENABLED=1
# ACCOUNT_HELP_EMAIL=anmeldetool@dpvonline.de

# Ziele der Links im Fußbereich jeder Seite und Inhaber im Copyright-Hinweis (#7). Ohne Angabe
# die Werte hier.
# IMPRESSUM_URL=https://dpvonline.de/impressum/
# DATENSCHUTZ_URL=https://dpvonline.de/datenschutz/
# COPYRIGHT_HOLDER=DPV e.V.

# Kennung, mit der das Tool beim Suchdienst von OpenStreetMap fragt (#163, Adresssuche). Dessen
# Nutzungsregeln wünschen eine Kontaktadresse des Teams, das das Tool betreibt, etwa
# „DPV-Anmeldetool (anmeldetool@dpvonline.de)“. Ohne Angabe nur „DPV-Anmeldetool“.
# ADRESSSUCHE_KENNUNG=DPV-Anmeldetool (anmeldetool@dpvonline.de)
