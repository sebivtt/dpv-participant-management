# Vorlage für die Umgebungsdatei der Testumgebung (#58). Kopieren nach testumgebung/.env
# (README.md, „Testumgebung im Container“); die Datei .env kommt nie ins Repo (.gitignore).
# Alle Werte hier sind erfunden und nur für den eigenen Rechner. Auf dem Server stehen
# eigene, geheime Werte (#59).

# Schlüssel, mit dem Django Sitzungen und Formulare absichert.
DJANGO_SECRET_KEY=testumgebung-lokal-nicht-geheim-auf-dem-server-ersetzen

# Namen, unter denen das Tool erreichbar ist. Auf dem Server die Testdomain.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Eigene Datenbank der Testumgebung (Container „datenbank“)
POSTGRES_DB=dpv
POSTGRES_USER=dpv
POSTGRES_PASSWORD=testumgebung-lokal-nicht-geheim

# Keycloak-Testumgebung auf dem eigenen Rechner (Profil „lokal“): Der Browser erreicht sie
# unter localhost:8081, das Tool im Container unter keycloak:8080.
KEYCLOAK_REALM_URL=http://localhost:8081/realms/dpv
KEYCLOAK_REALM_URL_INTERN=http://keycloak:8080/realms/dpv
KEYCLOAK_CLIENT_ID=dpv-anmeldetool
KEYCLOAK_CLIENT_SECRET=nur-lokal-nicht-geheim

# Nur auf dem Server, wenn dort ein Programm davor HTTPS annimmt (#59): 1 = Cookies nur über HTTPS.
# DJANGO_BEHIND_HTTPS_PROXY=1
