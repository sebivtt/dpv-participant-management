# Vorlage für die lokale Umgebungsdatei. Kopieren nach .env (README.md); die Datei .env
# kommt nie ins Repo (.gitignore). Alle Werte hier sind erfunden und nur für den eigenen
# Rechner gedacht. Auf einem Server stehen eigene, geheime Werte.
#
# Hier ist nur beschrieben, was allein für den eigenen Rechner gilt; alle übrigen
# Einstellungen beschreibt testumgebung/.env.example (#324).

# 1 = Fehleranzeige für Entwickler an, dazu der Bausteinkatalog unter /bausteine/. Nur auf dem
# eigenen Rechner mit erfundenen Daten; in der Testumgebung bleibt die Fehleranzeige trotzdem aus.
DJANGO_DEBUG=1

# 1 = eigener Rechner. Erst dann legt `python manage.py testdata` die erfundenen Testdaten an und
# leert dafür die Datenbank bis auf die Konten (#103). Nie auf einem Server eintragen.
LOCAL_ENVIRONMENT=1

# Rechner und Port der Datenbank aus dev/docker-compose.yml. Ohne Angabe localhost und 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Beschreibung: testumgebung/.env.example
DJANGO_SECRET_KEY=nur-lokal-nicht-geheim-bitte-auf-servern-ersetzen
POSTGRES_DB=dpv
POSTGRES_USER=dpv
POSTGRES_PASSWORD=nur-lokal-nicht-geheim
KEYCLOAK_REALM_URL=http://localhost:8080/realms/dpv
KEYCLOAK_CLIENT_ID=dpv-anmeldetool
KEYCLOAK_CLIENT_SECRET=nur-lokal-nicht-geheim
REGISTRATION_LINK_ENABLED=1
ACCOUNT_HELP_EMAIL=anmeldetool@dpvonline.de
