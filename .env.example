# Vorlage für die lokale Umgebungsdatei. Kopieren nach .env (README.md); die Datei .env
# kommt nie ins Repo (.gitignore). Alle Werte hier sind erfunden und nur für den eigenen
# Rechner gedacht. Auf einem Server stehen eigene, geheime Werte.

# Schlüssel, mit dem Django Sitzungen und Formulare absichert.
DJANGO_SECRET_KEY=nur-lokal-nicht-geheim-bitte-auf-servern-ersetzen

# 1 = Fehleranzeige für Entwickler an. Nur auf dem eigenen Rechner mit erfundenen Daten.
DJANGO_DEBUG=1

# Datenbank aus dev/docker-compose.yml
POSTGRES_DB=dpv
POSTGRES_USER=dpv
POSTGRES_PASSWORD=nur-lokal-nicht-geheim
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Keycloak aus dev/docker-compose.yml (#5): Adresse des Realms und Zugang des Login-Clients.
KEYCLOAK_REALM_URL=http://localhost:8080/realms/dpv
KEYCLOAK_CLIENT_ID=dpv-anmeldetool
KEYCLOAK_CLIENT_SECRET=nur-lokal-nicht-geheim

# 0 = Link „Noch kein Konto? Registrieren“ ausblenden. Dann nennt die Login-Seite diese Adresse.
REGISTRATION_LINK_ENABLED=1
ACCOUNT_HELP_EMAIL=anmeldetool@dpvonline.de
